# ── Database ──
DATABASE_URL=postgresql://appuser:pass@127.0.0.1:5432/messanger?schema=public

# ── Redis ──
REDIS_URL=redis://127.0.0.1:6379

# ── NextAuth ──
NEXTAUTH_SECRET=your-production-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Socket.io ──
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ── VAPID (Web Push) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key
VAPID_SUBJECT=mailto:you@example.com

# ── S3 / MinIO Storage ──
# Leave empty to use local filesystem (public/uploads/)
S3_ENDPOINT=https://your-s3-endpoint.amazonaws.com
S3_BUCKET=your-bucket
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# ── Whisper Voice Transcription ──
OPENAI_API_KEY=sk-your-key

# ── FFmpeg (optional, for HLS transcoding) ──
# FFmpeg must be installed and in PATH
# FFmpeg_PATH=

# ── LiveKit (SFU for group calls) ──
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ── Sentry (Error Monitoring) ──
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
